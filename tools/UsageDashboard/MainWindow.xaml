<Window x:Class="UsageDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usage - School PDF Sorter"
        Width="800" Height="620"
        MinWidth="660" MinHeight="500"
        Background="#141414"
        Foreground="#EDEDED"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="School PDF Sorter usage" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Unique installs come from the counter. Downloads are a rough signal only."
                       Foreground="#8C8C8C" FontSize="12" Margin="0,3,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1B1B1B" BorderBrush="#2A2A2A" BorderThickness="1"
                    Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Unique installs" Foreground="#8C8C8C" FontSize="12" />
                    <TextBlock x:Name="UniqueValue" AutomationProperties.AutomationId="UniqueValue" Text="-" FontSize="32" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#1B1B1B" BorderBrush="#2A2A2A" BorderThickness="1"
                    Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Active today" Foreground="#8C8C8C" FontSize="12" />
                    <TextBlock x:Name="TodayValue" AutomationProperties.AutomationId="TodayValue" Text="-" FontSize="32" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#1B1B1B" BorderBrush="#2A2A2A" BorderThickness="1"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Downloads" Foreground="#8C8C8C" FontSize="12" />
                    <TextBlock x:Name="DownloadsValue" AutomationProperties.AutomationId="DownloadsValue" Text="-" FontSize="32" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Expander Grid.Row="2" Header="Counter settings" Foreground="#DDDDDD" Margin="0,0,0,12">
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                    <TextBlock Text="Worker URL" Foreground="#8C8C8C" FontSize="12" />
                    <TextBox x:Name="WorkerBox" Margin="0,4,0,0" Padding="6,4"
                             Background="#0F0F0F" Foreground="#EDEDED" BorderBrush="#333333"
                             ToolTip="For example https://schoolpdfsorter-usage.account.workers.dev" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                    <TextBlock Text="Stats token" Foreground="#8C8C8C" FontSize="12" />
                    <PasswordBox x:Name="TokenBox" Margin="0,4,0,0" Padding="6,4"
                                 Background="#0F0F0F" Foreground="#EDEDED" BorderBrush="#333333" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="GitHub repo" Foreground="#8C8C8C" FontSize="12" />
                    <TextBox x:Name="RepoBox" Margin="0,4,0,0" Padding="6,4"
                             Background="#0F0F0F" Foreground="#EDEDED" BorderBrush="#333333" />
                </StackPanel>

                <Button Grid.Row="1" Grid.Column="1" Content="Save" Width="90" Height="30"
                        HorizontalAlignment="Left" Margin="8,22,0,0"
                        Background="#2A2A2A" Foreground="#EDEDED" BorderBrush="#3A3A3A"
                        Click="OnSave" />

                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0"
                           Foreground="#6F6F6F" FontSize="11.5" TextWrapping="Wrap"
                           Text="Saved on this PC at %LocalAppData%\SchoolPdfSorter\dashboard.json. The token is stored as plain text there." />
            </Grid>
        </Expander>

        <Border Grid.Row="3" Background="#1B1B1B" BorderBrush="#2A2A2A" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="History, recorded each time you refresh"
                           Margin="12,10,12,6" Foreground="#8C8C8C" FontSize="12" />

                <ListView x:Name="HistoryList" Grid.Row="1" Background="Transparent"
                          BorderThickness="0" Foreground="#EDEDED">
                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background" Value="#222222" />
                            <Setter Property="Foreground" Value="#CCCCCC" />
                            <Setter Property="BorderBrush" Value="#333333" />
                            <Setter Property="Padding" Value="6,4" />
                        </Style>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#EDEDED" />
                            <Setter Property="Padding" Value="4,2" />
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Date" Width="120" DisplayMemberBinding="{Binding Date}" />
                            <GridViewColumn Header="Unique installs" Width="130" DisplayMemberBinding="{Binding Total}" />
                            <GridViewColumn Header="Active" Width="90" DisplayMemberBinding="{Binding Today}" />
                            <GridViewColumn Header="Downloads" Width="110" DisplayMemberBinding="{Binding Downloads}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh"
                    Width="110" Height="32"
                    Background="#2A2A2A" Foreground="#EDEDED" BorderBrush="#3A3A3A"
                    Click="OnRefresh" />
            <TextBlock x:Name="Status" VerticalAlignment="Center" Foreground="#8C8C8C" />
        </DockPanel>
    </Grid>
</Window>
